GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_ALIGNMENT_ENABLED=true
GEMINI_ALIGNMENT_INTERVAL_MS=2500
# Optional alignment-only model override. Defaults to GEMINI_MODEL.
GEMINI_ALIGNMENT_MODEL=
GEMINI_LIVE_MODEL=gemini-3.8-live
# Never copy real keys into mobile/ source.
# Set these as process environment variables for a hosted backend.
# LENS_REMOTE_MODE=1
# LENS_ACCESS_KEY=<generate with secrets.token_urlsafe(32)>
